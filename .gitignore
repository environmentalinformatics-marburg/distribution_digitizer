# ============================================================
# Distribution Digitizer - Git Ignore Rules
# ============================================================

# --- Input & Output Data (do NOT track) ---
data/input/pages/
data/input/pages_all/
data/output/
data/temp/
temp/
tmp/

# --- Input templates (nicht versionieren) ---
data/input/templates/**/maps/
data/input/templates/**/align_ref/
data/input/templates/**/geopoints/
data/input/templates/**/symbols/

# --- Shiny generated / runtime data ---
app/www/output/
app/www/pages/
app/www/data/
app/www/align_png/
app/www/matching_png/
app/www/png/
app/www/generated/

# --- Allow other assets in app/www (CSS, JS, images etc.) ---
!app/www/
!app/www/*.css
!app/www/*.js
!app/www/*.html
!app/www/*.png
!app/www/*.jpg
!app/www/*.svg
!app/www/README.pdf


# --- R temporary & IDE files ---
.Rhistory
.RData
.Rproj.user/
.Ruserdata
*.Rproj

# --- Python cache & temp files ---
__pycache__/
*.pyc
*.pyo
*.log
*.bak
*.tmp

# --- OS files ---
.DS_Store
Thumbs.db

# --- Backup files ---
*.old
*.orig
